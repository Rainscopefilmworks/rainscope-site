# Cloudflare Pages Headers
# Add custom headers for security and performance

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self "https://js.squareup.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://tally.so https://js.squareup.com https://web.squarecdn.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://web.squarecdn.com; img-src 'self' data: https: blob:; font-src 'self' data: https://square-fonts-production-f.squarecdn.com https://*.cloudfront.net; connect-src 'self' https://www.google-analytics.com https://rainscope-square-proxy.sweet-queen-15c3.workers.dev https://api.squareup.com https://tally.so https://connect.squarecdn.com https://pci-connect.squareup.com https://*.ingest.sentry.io; frame-src 'self' https://www.google.com https://tally.so https://js.squareup.com https://web.squarecdn.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://tally.so; upgrade-insecure-requests;

# Cache static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache videos
/assets/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS
# With versioned URLs (query strings), we can use long cache with immutable
# For non-versioned files, stale-while-revalidate provides performance boost
/assets/css/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800

# Cache favicons (long cache since they rarely change)
/assets/images/favicon-*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/images/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/assets/images/android-chrome-*.png
  Cache-Control: public, max-age=31536000, immutable

# Cache sitemap and robots.txt (short cache for SEO updates)
/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/video-sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# HTML files - no cache (always check for updates)
/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-cache

