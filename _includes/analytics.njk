<script>
  (function initRainscopeAnalytics() {
    if (window.__rainscopeAnalyticsLoaded) return;
    window.__rainscopeAnalyticsLoaded = true;

    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag(){ dataLayer.push(arguments); };

    window.rainscopeTrack = function rainscopeTrack(eventName, params) {
      if (!eventName || typeof window.gtag !== 'function') return;
      window.gtag('event', eventName, params || {});
    };

    function trackPageView() {
      window.rainscopeTrack('page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname + window.location.search + window.location.hash,
      });
    }

    function loadAnalytics() {
      if (window.__rainscopeAnalyticsBooted) return;
      window.__rainscopeAnalyticsBooted = true;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-7RRQQ33JKM';
      document.head.appendChild(script);

      window.gtag('js', new Date());
      window.gtag('config', 'G-7RRQQ33JKM', { send_page_view: false });
      window.setTimeout(trackPageView, 1200);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function onReady() {
        window.setTimeout(loadAnalytics, 800);
      }, { once: true });
    } else {
      window.setTimeout(loadAnalytics, 800);
    }
  })();
</script>
